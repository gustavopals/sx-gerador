# SXGerador — variáveis de ambiente para PRODUÇÃO.
# Copie para .env.production e preencha. NUNCA commit este arquivo com valores reais.

# ─── Domínios e ACME ──────────────────────────────────────────────────────
PUBLIC_DOMAIN=sxgerador.com.br
PUBLIC_APP_URL=https://sxgerador.com.br
ACME_EMAIL=ops@sxgerador.com.br

# ─── Banco de dados ───────────────────────────────────────────────────────
POSTGRES_DB=sxgerador
POSTGRES_USER=sxgerador
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT secrets ──────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET

# ─── SMTP (envio de emails de convite, verificação, reset de senha) ───────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@sxgerador.com.br
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="SXGerador <hello@sxgerador.com.br>"

# ─── Imagens Docker (registry) ────────────────────────────────────────────
API_IMAGE=ghcr.io/sxgerador/sxgerador-api:latest
WEB_IMAGE=ghcr.io/sxgerador/sxgerador-web:latest
DOCS_IMAGE=ghcr.io/sxgerador/sxgerador-docs:latest

# ─── Backup ───────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14

# ─── Observabilidade ──────────────────────────────────────────────────────
LOG_LEVEL=info
