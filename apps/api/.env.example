NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200
DATABASE_URL="postgresql://sxgerador:sxgerador@localhost:5432/sxgerador?schema=public"

# Auth
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email
# Leave SMTP_HOST empty to log emails to the console (dev mode)
APP_URL=http://localhost:4200
EMAIL_FROM="SXGerador <noreply@sxgerador.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Example for Resend (SMTP relay):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key_here
# SMTP_SECURE=true
