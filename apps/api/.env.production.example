# API — variáveis de ambiente para produção.
# Copie para apps/api/.env.production e preencha.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://sxgerador:CHANGE_ME@postgres:5432/sxgerador?schema=public

# Gere com: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@sxgerador.com.br
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="SXGerador <hello@sxgerador.com.br>"

PUBLIC_APP_URL=https://sxgerador.com.br
LOG_LEVEL=info
