generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuario da plataforma SXGerador.
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String
  avatarUrl             String?
  emailVerified         Boolean   @default(false)
  locale                String    @default("pt-BR")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?
  deletedAt             DateTime?
  hardDeleteScheduledAt DateTime?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([deletedAt])
  @@index([hardDeleteScheduledAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Project {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  visibility    ProjectVisibility @default(PRIVATE)
  defaultTamFil Int               @default(2)
  defaultLang   String            @default("pt-BR")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([visibility])
  @@index([deletedAt])
}
