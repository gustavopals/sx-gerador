{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API do SXGerador.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts --ignore-pattern src/generated",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "test": "echo \"No api tests configured yet\"",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sxgerador/shared-types": "workspace:*",
    "@prisma/client": "6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "4.22.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "prisma": "6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  }
}
